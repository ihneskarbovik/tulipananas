  "title": "Hvilken disippel er du i dag?",
  "intro": "Jesus hadde tolv disipler, og alle var forskjellige: fiskere, en tollinnkrever, noen ivrige og noen stille. Svar på sju litt rare spørsmål og finn ut hvilken disippel du er i dag.",
  "questions": [
    {
      "id": "q1",
      "text": "En elefant vil bli med på kino. Hvor sitter den?",
      "options": [
        {
          "id": "a",
          "text": "Helt bakerst, så alle andre ser",
          "scores": {
            "jakob": 2,
            "taddeus": 1
          }
        },
        {
          "id": "b",
          "text": "Ved siden av meg, med popkorn",
          "scores": {
            "tomas": 2,
            "peter": 2
          }
        },
        {
          "id": "c",
          "text": "På første rad",
          "scores": {
            "jakobalfeus": 2,
            "simon": 2
          }
        },
        {
          "id": "d",
          "text": "I midtgangen, den trenger plass",
          "scores": {
            "johannes": 2,
            "bartolomeus": 2
          }
        },
        {
          "id": "e",
          "text": "Den kjøper to seter",
          "scores": {
            "mattias": 2,
            "jakobalfeus": 2
          }
        },
        {
          "id": "f",
          "text": "Den ser filmen hjemme og forteller meg om den etterpå",
          "scores": {
            "simon": 2,
            "matteus": 1
          }
        }
      ]
    },
    {
